# Server Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1
BASE_URL=https://hvh-api-production.up.railway.app
ALLOWED_ORIGINS=https://hvh-api-production.up.railway.app,https://hvh-5mq827adr-thanhdats-projects-8402b56b.vercel.app,https://hvh-web.vercel.app,http://localhost:3000

# Database Configuration (MySQL với Prisma)
DATABASE_URL="mysql://root:@localhost:3306/hvh_hotel"
# Backup MongoDB (để tham khảo)
# MONGODB_URI=mongodb+srv://linhhoai:linhhoai69@cluster0.mnqdljf.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# JWT Configuration
JWT_SECRET=your_very_strong_jwt_secret_key_here
JWT_REFRESH_SECRET=your_very_strong_refresh_secret_key_here
JWT_ACTIVATION_SECRET=your_activation_secret_key_here
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Email Configuration (for future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Redis Configuration (for future use)
REDIS_URL=redis://localhost:6379


