# Production Environment Variables
NODE_ENV=production
PORT=3001
API_VERSION=v1

# Database Configuration - MySQL với Prisma
DATABASE_URL="mysql://username:password@localhost:3306/database_name?connection_limit=5&pool_timeout=20"

# JWT Configuration
JWT_SECRET=your_production_jwt_secret_key_here

# CORS Origins
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com